CREATE FUNCTION public.check_budget_dipartimento() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    budget_totale NUMERIC;
    costo_campagne_esistenti NUMERIC;
BEGIN
    SELECT budget_annuale INTO budget_totale
    FROM dipartimento
    WHERE id_dipartimento = NEW.id_dipartimento;

    SELECT COALESCE(SUM(costo_stimato), 0) INTO costo_campagne_esistenti
    FROM campagna_marketing
    WHERE id_dipartimento = NEW.id_dipartimento
      AND id_campagna != NEW.id_campagna; 

    IF (costo_campagne_esistenti + NEW.costo_stimato) > budget_totale THEN
        RAISE EXCEPTION 'Budget insufficiente! Il costo della campagna supera il budget rimanente del dipartimento.';
    END IF;

    RETURN NEW;
END;
$$;


