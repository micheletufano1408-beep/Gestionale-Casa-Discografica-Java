<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Login">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
    <margin top="30" left="30" bottom="30" right="30"/>
    <constraints>
      <xy x="20" y="20" width="400" height="269"/>
    </constraints>
    <properties/>
    <border type="none" title="Accesso al Sistema Gestionale"/>
    <children>
      <component id="lblUser" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Username:"/>
        </properties>
      </component>
      <component id="txtUser" class="javax.swing.JTextField" binding="inserisciUsername">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="lblPass" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Password:"/>
        </properties>
      </component>
      <component id="txtPass" class="javax.swing.JPasswordField" binding="inserisciPassword">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="btnLog" class="javax.swing.JButton" binding="accediButton">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Accedi"/>
        </properties>
      </component>
      <component id="btnReg" class="javax.swing.JButton" binding="btnRegistrati">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Crea nuovo account"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
