<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.aggiungiManager">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
    <margin top="25" left="25" bottom="25" right="25"/>
    <constraints>
      <xy x="20" y="20" width="450" height="400"/>
    </constraints>
    <properties/>
    <border type="none" title="Inserimento Nuovo Manager"/>
    <children>

      <component id="lbl1" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="ID Manager:"/></properties>
      </component>
      <component id="c1" class="javax.swing.JTextField" binding="inserisciId">
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="200" height="-1"/></grid></constraints>
        <properties/>
      </component>

      <component id="lbl2" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Nome:"/></properties>
      </component>
      <component id="c2" class="javax.swing.JTextField" binding="inserisciNome">
        <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="200" height="-1"/></grid></constraints>
        <properties/>
      </component>

      <component id="lbl3" class="javax.swing.JLabel">
        <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Cognome:"/></properties>
      </component>
      <component id="c3" class="javax.swing.JTextField" binding="inserisciCognome">
        <constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="200" height="-1"/></grid></constraints>
        <properties/>
      </component>

      <component id="lbl4" class="javax.swing.JLabel">
        <constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Data di Assunzione (YYYY-MM-DD):"/></properties>
      </component>
      <component id="c4" class="javax.swing.JTextField" binding="inserisciDataAssunzione">
        <constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="200" height="-1"/></grid></constraints>
        <properties/>
      </component>

      <component id="lbl5" class="javax.swing.JLabel">
        <constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Bonus Percentuale (%):"/></properties>
      </component>
      <component id="c5" class="javax.swing.JTextField" binding="inserisciBonus">
        <constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="200" height="-1"/></grid></constraints>
        <properties/>
      </component>

      <vspacer id="vsp1">
        <constraints><grid row="5" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/></constraints>
      </vspacer>

      <component id="c6" class="javax.swing.JButton" binding="confermaButton">
        <constraints><grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Conferma e Salva Manager"/></properties>
      </component>

    </children>
  </grid>
</form>